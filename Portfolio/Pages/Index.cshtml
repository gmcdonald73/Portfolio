@page
@model IndexModel

<div class="text-center">

    <h1 class="display-6">
        Graeme McDonald
    </h1>

    <h3>
        Senior Software Developer
    </h3>

    <p class="lead">
        Building simulation engines,
        trading tools and modern .NET applications.
    </p>

</div>

<hr />

<h2>
    Featured Projects
</h2>
<p>A selection of my recent and notable projects.</p>

<div class="row">

    @foreach (var project in Model.FeaturedProjects)
    {
        <div class="col-12 col-md-6 mb-4">
            <partial name="_ProjectCard" model="project" />
        </div>
    }

</div>

<div class="text-center">

    <a class="btn btn-primary"
       asp-page="/Projects/Index">
        View All Projects
    </a>

</div>
