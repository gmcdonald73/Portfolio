@page
@model Portfolio.Pages.Projects.IndexModel

@{
    ViewData["Title"] = "Projects";
}

<div class="text-center mb-5">

    <h1 class="display-6">Projects</h1>

    <p class="lead">
        A collection of applications and technical projects I've built.
    </p>

</div>

<div class="row gx-2">

    @foreach (var project in Model.Projects.Where(p => !p.Hide).OrderBy(p => p.Order))
    {
        <div class="col-12 col-md-6 col-lg-4 mb-4">

            <partial name="_ProjectCard" model="project" />
        </div>
    }

</div>

