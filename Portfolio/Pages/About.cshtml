@page
@model Portfolio.Pages.AboutModel

@{
    ViewData["Title"] = "About";
}

<div class="text-center mb-5">

    <h1 class="display-4">About Me</h1>

    <p class="lead">
        Senior Software Developer with a passion for building
        interesting and useful software.
    </p>

</div>

<div class="row justify-content-center">

    <div class="col-lg-8">

        <h2>Hi, I'm Graeme</h2>

        <p>
            I'm a software developer with over 16 years of experience
            building applications using Microsoft technologies.
        </p>

        <p>
            My professional experience includes C#, VB.NET, SQL Server
            and financial systems, and I'm currently exploring modern
            .NET and ASP.NET Core development.
        </p>

        <p>
            Outside of my professional work, I enjoy building projects
            that combine software development with mathematics,
            simulation and problem solving.
        </p>

        <h2 class="mt-5">What I Enjoy Building</h2>

        <ul>
            <li>Simulation and probability models</li>
            <li>Financial and trading tools</li>
            <li>Data-driven web applications</li>
            <li>Interesting mathematical problems</li>
        </ul>

        <h2 class="mt-5">Technologies</h2>

        <div class="mt-3">

            <span class="badge bg-primary">C#</span>
            <span class="badge bg-primary">ASP.NET Core</span>
            <span class="badge bg-primary">Razor Pages</span>
            <span class="badge bg-primary">SQL Server</span>
            <span class="badge bg-primary">Azure</span>
            <span class="badge bg-primary">JavaScript</span>
            <span class="badge bg-primary">Bootstrap</span>
            <span class="badge bg-primary">Git</span>

        </div>

        <p class="mt-5">
            <a href="https://www.linkedin.com/in/graeme-mcdonald73/"
               target="_blank"
               rel="noopener noreferrer">
                View my LinkedIn profile
            </a>
        </p>

    </div>

</div>
